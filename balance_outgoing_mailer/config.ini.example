; ============================================================
;  BALANCE OUTGOING 자동발송 설정파일  (balance_outgoing_mailer.py 와 같은 폴더에 둘 것)
;  값만 채워 넣으면 됩니다. 코드 수정 불필요.
;
;  ※ 이 파일을 config.ini 로 복사한 뒤 값을 채우세요.
;  ※ config.ini 에는 비밀번호가 들어가므로 절대 git 에 커밋하지 마세요(.gitignore 로 이미 제외됨).
;  ※ 경로는 되도록 비워 두세요. 비우면 코드가 '스크립트가 있는 폴더' 기준으로 알아서 찾습니다.
;     절대경로를 박으면 폴더를 옮기거나 다른 PC 에 배포할 때 그대로 깨집니다.
; ============================================================

[db]
; --- Oracle 접속정보 ---
user            = ADMIN
password        = <DB비밀번호>             ; 비워두면 첫 실행 시 물어보고 저장합니다

; OCI Autonomous DB(월렛) 사용 시: dsn = TNS 별칭. tnsnames.ora 에 '실제로 있는' 이름을 쓸 것.
; 사내망 직접접속 사용 시       : dsn = host:port/service_name (easy connect), wallet_dir 비워둠
dsn             = changshinincaipoc_medium

; 월렛 폴더. **비워두는 것을 권장** — 비우면 이 스크립트와 같은 폴더의 wallet/ 을 자동 사용합니다.
; 굳이 지정한다면 한글·공백·OneDrive 가 없는 경로로 (예: C:\oracle\wallet\changshinincaipoc)
wallet_dir      =
wallet_password =                          ; thin 모드에서만 필요한 월렛 비번(PEM pass phrase)

; 접속 모드
;   auto  (권장) thick 먼저 시도 → 실패하면 thin 으로 자동 폴백
;   thick        Oracle Instant Client + cwallet.sso 자동로그인 (월렛 비번 불필요)
;   thin         Instant Client 불필요, 대신 wallet_password 필요
mode            = auto
; thick 모드에서 Instant Client 를 자동으로 못 찾을 때만 폴더 경로를 적습니다.
;   Windows 예: C:\oracle\instantclient_23_5
oracle_client_lib =

; CKP Manual Report(make_all.py)가 쓰는 SQLcl 저장 연결 이름.
; **비워두면 등록된 연결 목록에서 자동 탐색**합니다(changshinincaipoc → *_medium → csi*).
; PC 마다 연결 이름이 달라도 되므로 특별한 이유가 없으면 비워 두세요.
sqlcl_conn      =

[smtp]
; --- 사내 SMTP 서버 ---
host     = smtp.changshininc.com
port     = 587
use_tls  = true
user     =                  ; SMTP 인증 계정(필요 없으면 비워둠)
password =                  ; Gmail 이면 '앱 비밀번호'
from     = balance-outgoing@changshininc.com

[report]
; --- 리포트 범위·수신자 ---
plants          = 3110,3120,3210      ; 포함할 공장 코드 (쉼표구분)
window_before   = 3                    ; D+3 (납기 경과 며칠까지)
window_after    = 7                    ; D-7 (선행 며칠까지)
recipients      = name1@changshininc.com, name2@changshininc.com   ; 받는사람 (쉼표구분, 여러 명 가능)
strict_outgoing = false                ; OCI 동기화 완료 후 true (GMES 정식 미출고 로직)

; 리포트 저장 폴더. **비우면 스크립트 상위의 report/ 를 자동 사용** (권장)
output_dir      =
; 메일 본문에 넣을 공유 링크 (첨부 대신 링크로 보낼 때)
share_link      =

; --- CKP Manual Report(make_all.py) 전용 ---
; No.2 존(zone) 양식 템플릿용 원본 "CKP Manual Report (종합).xlsx" 전체경로.
; 비우면 --src 인자 또는 ckp_reports 상위 폴더의 후보경로를 순서대로 찾습니다.
src_workbook    =
