; ============================================================
;  CKP 리포트 설정  (이 파일 한 곳만 고치면 됩니다)
; ============================================================

[db]
; backend = auto | oracledb | sqlcl
;   auto : 아래 user/password 가 채워져 있으면 드라이버로 직접 접속(SQLcl·Java 불필요),
;          비어 있으면 SQLcl 저장 연결을 사용합니다.
backend         = auto
; --- 드라이버로 직접 접속할 때만 채우세요 ---
user            =
password        =
wallet_password =                ; 지갑 zip 받을 때 정한 비밀번호
dsn             = changshinincaipoc_medium
wallet_dir      =                ; 비우면 balance_outgoing_mailer\wallet 을 자동으로 찾습니다
mode            = auto           ; Instant Client 있으면 thick, 없으면 thin 폴백
oracle_client_lib =
sqlcl_conn      = changshinincaipoc
; --- 사내망이 특이할 때만 건드리세요 ---
; preflight = auto | off   접속 전에 DB 포트가 열려 있는지 먼저 확인(기본 auto).
;   방화벽이 막았을 때 1분 매달리는 대신 6초 만에 원인을 알려 줍니다.
preflight       = auto
; 프록시를 거쳐야만 바깥으로 나가는 망이면 아래 둘을 채우세요.
;   채우면 사전 확인은 자동으로 건너뜁니다.
https_proxy     =
https_proxy_port =

[report]
; 대상 공장 (CKP=3120). 코드에 박지 않고 여기서 정합니다.
plant           = 3120
; 리포트 기준 타임존. 어느 PC 에서 돌리든 같은 날짜가 나오게 합니다.
;   ⚠ DB 날짜 컬럼은 현장(WIB) 기준이라 KST 00:00~01:59 두 시간만 하루 어긋납니다.
site_timezone   = Asia/Seoul
; 마감(CLOSING) 필터. auto = 마스터 커버리지를 재서 자동 선택(권장)
;   2026-07-28 기준 커버리지 0%% (마스터 미동기화) → loose 로 동작.
;   원장 동기화가 끝나면 설정을 안 바꿔도 정식 필터로 자동 전환됩니다.
closing_filter  = auto
plants          = 3110,3120,3210
window_before   = 3
window_after    = 7
strict_outgoing = false
src_workbook    =
